{
  // Standalone build config. Upstream this package extends ../../../tsconfig.base.json
  // and references ~20 workspace projects; here the same compiler options are
  // inlined and those edges become ordinary npm dependencies (see package.json).
  // tsconfig.upstream.json keeps the original for reference.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": false,
    "declarationMap": false,
    "composite": false,
    "incremental": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    "rootDir": "src",
    "outDir": "lib/types"
  },
  "include": ["src"]
}
